name: Publish academic profile

on:
  push:
    branches: [main]
  workflow_dispatch:
  schedule:
    - cron: '17 6 1 * *'

permissions:
  contents: write
  pages: write
  id-token: write

concurrency:
  group: academic-profile-pages
  cancel-in-progress: false

jobs:
  publish:
    if: github.event_name != 'schedule' || vars.ENABLE_SCHOLAR_UPDATES == 'true'
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        if: github.event_name != 'push' && vars.ENABLE_SCHOLAR_UPDATES == 'true'
        with:
          python-version: '3.12'
      - name: Refresh citations when enabled
        if: github.event_name != 'push' && vars.ENABLE_SCHOLAR_UPDATES == 'true'
        env:
          SERPAPI_API_KEY: ${{ secrets.SERPAPI_API_KEY }}
        run: python scripts/update_citations.py
      - name: Save refreshed count and date
        if: github.event_name != 'push' && vars.ENABLE_SCHOLAR_UPDATES == 'true'
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add index.html cv.html
          if ! git diff --cached --quiet; then
            git commit -m "Refresh Google Scholar citations"
            git push
          fi
      - uses: actions/configure-pages@v5
      - name: Prepare public website files
        run: |
          mkdir _site
          cp index.html cv.html styles.css script.js .nojekyll _site/
          cp -r assets _site/
      - uses: actions/upload-pages-artifact@v3
        with:
          path: _site
      - name: Deploy GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
